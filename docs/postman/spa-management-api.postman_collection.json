{
	"info": {
		"_postman_id": "9f2c1a4e-6b7d-4c3e-a1b2-3c4d5e6f7a8b",
		"name": "SPA Management API",
		"description": "Postman collection for the SPA booking platform API (v1). All responses use the contract envelope `{ success, message, data }`; errors use `{ success:false, message, code, errors? }`.\n\n**Auth:** Bearer access token via `{{base_url}}/api/v1/auth/login`. Admin demo account: mobile `9800000000`, password `ChangeMe!2026`. Business owner demo: `9811111111` / `OwnerPass!1`.\n\nLogin/register-verify requests automatically store `{{access_token}}` and `{{refresh_token}}` collection variables.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{ "key": "base_url", "value": "http://127.0.0.1:8000/api/v1" },
		{ "key": "access_token", "value": "" },
		{ "key": "refresh_token", "value": "" }
	],
	"auth": {
		"type": "bearer",
		"bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
	},
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Register",
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"mobile_number\": \"+9779812345678\",\n  \"password\": \"Customer#1\",\n  \"display_name\": \"Test Customer\"\n}" },
						"url": { "raw": "{{base_url}}/auth/register", "host": ["{{base_url}}"], "path": ["auth", "register"] },
						"description": "Creates an account and issues a 4-digit verification code (delivered via the notification/log channel)."
					}
				},
				{
					"name": "Verify registration",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const body = pm.response.json();",
									"if (body && body.data && body.data.access_token) {",
									"  pm.collectionVariables.set('access_token', body.data.access_token);",
									"  pm.collectionVariables.set('refresh_token', body.data.refresh_token);",
									"}"
								]
							}
						}
					],
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"user_id\": \"<ULID from register>\",\n  \"code\": \"1234\"\n}" },
						"url": { "raw": "{{base_url}}/auth/register/verify", "host": ["{{base_url}}"], "path": ["auth", "register", "verify"] }
					}
				},
				{
					"name": "Resend verification",
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"user_id\": \"<ULID from register>\"\n}" },
						"url": { "raw": "{{base_url}}/auth/verification/resend", "host": ["{{base_url}}"], "path": ["auth", "verification", "resend"] }
					}
				},
